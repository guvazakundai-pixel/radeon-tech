{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/shop/:path*", "destination": "/index.html" },
    { "source": "/repair", "destination": "/index.html" },
    { "source": "/pc-builder", "destination": "/index.html" }
  ]
}
